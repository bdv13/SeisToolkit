from data_types import Dataset, create_text_hdr, create_bin_hdr


def is_compatible(datasets):

    bin_check = {"dt": set(), "numsmp": set(), "fmt_code": set()}
    tr_check = {"dt": set(), "numsmp": set()}

    for dataset in datasets:
        bin_check["dt"].add(dataset.dt)
        bin_check["numsmp"].add(dataset.numsmp)
        bin_check["fmt_code"].add(dataset.fmt_code)
        for trace in dataset.traces():
            tr_check["dt"].add(trace.dt)
            tr_check["numsmp"].add(trace.numsmp)

    for hdr in bin_check:
        if len(bin_check[hdr]) != 1:
            return False

    for hdr in tr_check:
        if len(tr_check[hdr]) != 1:
            return False

    for parameter in bin_check:
        bin_check[parameter] = list(bin_check[parameter])

    parameters = (bin_check["dt"], bin_check["dt"], bin_check["fmt_code"])

    return parameters


def combine_datasets(datasets: Dataset) -> Dataset:
    """Combine several datasets into one dataset."""

    if not is_compatible(datasets):
        raise ValueError("Not compatible datasets!")
    else:
        dt, numsmp, fmt_code = is_compatible(datasets)

    text_hdr = create_text_hdr()

    bin_hdr = create_bin_hdr(dt, numsmp, fmt_code)

    combined_traces = []
    for dataset in datasets:
        for trace in dataset.traces:
            combined_traces.append(trace)

    return Dataset('merged', text_hdr, '>', bin_hdr, combined_traces)
